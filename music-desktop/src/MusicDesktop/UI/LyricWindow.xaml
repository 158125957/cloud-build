<Window x:Class="MusicDesktop.UI.LyricWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音乐桌面 · 歌词" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" Width="1200" Height="240"
        WindowStartupLocation="Manual" SizeToContent="Manual" SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Grid x:Name="Root" Background="Transparent" Margin="24,10,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 当前行 + 卡拉OK 扫光 -->
        <Grid x:Name="LineHost" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="BaseText" Text="音乐桌面" FontFamily="Microsoft YaHei UI, Segoe UI"
                       FontSize="44" FontWeight="Bold" Foreground="#59FFFFFF"
                       TextOptions.TextRenderingMode="Grayscale" TextOptions.TextFormattingMode="Ideal">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.85" Color="#000000" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="FillText" Text="音乐桌面" FontFamily="Microsoft YaHei UI, Segoe UI"
                       FontSize="44" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                       TextOptions.TextRenderingMode="Grayscale" TextOptions.TextFormattingMode="Ideal">
                <TextBlock.Clip>
                    <RectangleGeometry x:Name="FillClip" Rect="0,0,0,400" />
                </TextBlock.Clip>
                <TextBlock.Effect>
                    <DropShadowEffect x:Name="FillGlow" BlurRadius="26" ShadowDepth="0" Opacity="0.75" Color="{DynamicResource GlowColor}" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>

        <TextBlock x:Name="TranslationText" Grid.Row="1" HorizontalAlignment="Center" Margin="0,6,0,0"
                   FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="18" Foreground="#C2FFFFFF"
                   TextOptions.TextRenderingMode="Grayscale" TextOptions.TextFormattingMode="Ideal">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.8" Color="#000000" />
            </TextBlock.Effect>
        </TextBlock>

        <TextBlock x:Name="NextText" Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,0"
                   FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="19" Foreground="#40FFFFFF"
                   TextOptions.TextRenderingMode="Grayscale" />

        <!-- 悬停工具条 -->
        <Border x:Name="Toolbar" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0"
                Background="#CC0B0E14" CornerRadius="12" BorderBrush="#22FFFFFF" BorderThickness="1"
                Padding="6,3" Margin="0,-2,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnLock" Style="{StaticResource IconButton}" Content="&#xE72E;" ToolTip="锁定歌词（点击穿透）" Click="BtnLock_Click" />
                <Button x:Name="BtnMinus" Style="{StaticResource IconButton}" Content="A-" ToolTip="缩小字号" Click="BtnFontMinus_Click" FontFamily="Segoe UI" />
                <Button x:Name="BtnPlus" Style="{StaticResource IconButton}" Content="A+" ToolTip="放大字号" Click="BtnFontPlus_Click" FontFamily="Segoe UI" />
                <Button x:Name="BtnEarlier" Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="歌词提前 200ms" Click="BtnEarlier_Click" />
                <Button x:Name="BtnLater" Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="歌词延后 200ms" Click="BtnLater_Click" />
                <Button x:Name="BtnClose" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="隐藏歌词" Click="BtnClose_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
