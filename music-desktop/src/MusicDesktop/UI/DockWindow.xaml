<Window x:Class="MusicDesktop.UI.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音乐桌面 · Dock" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" Topmost="True" SnapsToDevicePixels="True">

    <Border x:Name="DockRoot" CornerRadius="22" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="9,7"
            MouseLeftButtonDown="DockRoot_MouseLeftButtonDown" MouseRightButtonUp="DockRoot_MouseRightButtonUp">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <StackPanel x:Name="ItemsHost" Orientation="Horizontal" />
    </Border>
</Window>
